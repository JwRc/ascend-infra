# ── Imagens ────────────────────────────────────────────────
# Prefixo do registry (ex: ghcr.io/sua-org/). Deixe vazio para imagens locais.
REGISTRY=
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=ascentio
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme

# ── Auth (better-auth) ─────────────────────────────────────
BETTER_AUTH_SECRET=changeme_use_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost

# ── Métricas (Prometheus) ──────────────────────────────────
# Precisa bater com o bearer_token em infra/observability/prometheus/prometheus.yml
METRICS_TOKEN=changeme

# ── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple OAuth ────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Notificações ───────────────────────────────────────────
FCM_SERVER_KEY=
RESEND_API_KEY=
EMAIL_FROM=noreply@ascentio.com.br

# ── CORS: origins permitidas (separadas por vírgula) ───────
TRUSTED_ORIGINS=http://localhost

# ── Stripe (chave pública do frontend) ────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_

# ── Libredesk (Suporte) ──────────────────────────────────────
# LIBREDESK_BASE_URL não é configurável aqui — é sempre http://libredesk:9000
# (nome do serviço na rede interna do compose), fixo em docker-compose.yml.
# LIBREDESK_DB_* provisiona o banco do Libredesk dentro do Postgres
# compartilhado (só tem efeito na primeira subida, com o volume pgdata vazio
# — ver postgres-init/; em volume já existente rode ./libredesk-db-init.sh).
LIBREDESK_DB_NAME=libredesk
LIBREDESK_DB_USER=libredesk_user
LIBREDESK_DB_PASSWORD=changeme_use_openssl_rand_hex_20
# Senha do usuário "System" (root/admin) do Libredesk, aplicada no primeiro
# boot do container. A política do Libredesk exige 10-72 caracteres com pelo
# menos uma maiúscula, uma minúscula, um número E um caractere especial — a
# saída crua de `openssl rand -hex/-base64` NÃO passa (não tem especial).
# Gere com: printf '%s' "$(openssl rand -base64 18)" && echo 'Aa1!' (concatene)
LIBREDESK_SYSTEM_USER_PASSWORD=changeme_10a72_com_maiuscula_minuscula_numero_e_especial_Aa1!
# Chave de criptografia da app — precisa ter EXATAMENTE 32 caracteres hex.
# Gere com: openssl rand -hex 16
LIBREDESK_ENCRYPTION_KEY=changeme_openssl_rand_hex_16
# Credenciais da API key do agente de serviço que o backend usa para chamar
# a REST API do Libredesk — geradas por ../backend/scripts/libredesk-setup.sh
# (não pela imagem do Libredesk). Deixe em branco até rodar o script.
LIBREDESK_API_KEY=
LIBREDESK_API_SECRET=
LIBREDESK_INBOX_ID=
# Secret do webhook Libredesk -> backend. Gere com: openssl rand -hex 24 e
# passe o MESMO valor pro libredesk-setup.sh via LIBREDESK_WEBHOOK_SECRET=...
# (senão o script gera um novo e os dois lados ficam dessincronizados).
LIBREDESK_WEBHOOK_SECRET=changeme_use_openssl_rand_hex_24
LIBREDESK_TENANT_ATTR=tenant
LIBREDESK_FETCH_TIMEOUT_MS=15000
# Domínio público da UI de agentes do Libredesk, roteado pelo nginx
# (server_name suporte.ascentio.com.br em nginx/conf.d/default.conf) —
# precisa de DNS apontando pro servidor e de um certificado Let's Encrypt
# para esse domínio antes do nginx conseguir subir.
LIBREDESK_WEB_DOMAIN=suporte.ascentio.com.br
# Porta do Libredesk no host, só em loopback (127.0.0.1) — usada para rodar
# ../backend/scripts/libredesk-setup.sh via túnel SSH e para o
# --set-system-user-password, independente da rota pública pelo nginx.
LIBREDESK_PORT=9000

# ── Slack (alerta de novo ticket de suporte via Incoming Webhook) ─
SLACK_SUPPORT_WEBHOOK_URL=

# ── Portas expostas pelo nginx ─────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
